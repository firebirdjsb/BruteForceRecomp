# Both source inventories belong to the authenticated retail translation.
# The public toolkit and canonical generated files are never edited.
set(camera_matches 0)
set(rotation_matches 0)
foreach(file IN LISTS BF_GENERATED)
    file(READ "${file}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(FIND "${text}" "void sub_001332A0(void)" camera_start)
    if(NOT camera_start EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "f8bc7d9b5d74a58015740f1f620291267b3d80545fbb8d0816f0bcfaf30720ba")
            message(FATAL_ERROR "Unaudited retail camera update; native mouse integration refused.")
        endif()
        # Original slots: +0x14 controller component, +0x18 pitch rate,
        # +0x1C yaw rate, +0x74 seconds; EBP is the owning actor.
        # After aim curves/ramp/assistance, before authored weapon motion.
        set(anchor "loc_00133EA3: ;\n    eax = MEM32(ebp + 0x7A8);")
        string(FIND "${text}" "${anchor}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Expected exact native camera handoff.")
        endif()
        string(PREPEND text "extern void bf_mkb_camera_frame(unsigned,unsigned,unsigned,unsigned);\n")
        # 0x469948 is this authenticated image's input-manager pointer slot,
        # also read by original 0x0013358A; actual manager/records are dynamic.
        string(REPLACE "${anchor}" "loc_00133EA3: ;\n    bf_mkb_camera_frame(MEM32(esp+0x14),ebp,esp,MEM32(0x469948));\n    eax = MEM32(ebp + 0x7A8);" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/game-native-camera.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR camera_matches "${camera_matches}+1")
    endif()
    string(FIND "${text}" "void sub_0011E5E0(void)" rotation_start)
    if(NOT rotation_start EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "f93da1601f97730e3c7dd18aa10dfb798e643d223a19cee44a494bb0ebbe8a41")
            message(FATAL_ERROR "Unaudited original rotation fixture.")
        endif()
        set(fixture "#define RECOMP_GENERATED_CODE\n#include \"recomp_funcs.h\"\n")
        foreach(entry IN ITEMS 0011E5E0 0011E7C0 0011E840)
            string(FIND "${text}" "void sub_${entry}(void)" first)
            string(SUBSTRING "${text}" ${first} -1 tail)
            string(FIND "${tail}" "\n/**" last)
            if(first LESS 0 OR last LESS 0)
                message(FATAL_ERROR "Expected bounded original rotation body.")
            endif()
            string(SUBSTRING "${tail}" 0 ${last} body)
            string(APPEND fixture "${body}\n")
        endforeach()
        file(WRITE "${CMAKE_BINARY_DIR}/runtime-fixes/native-camera-fixture.c.in" "${fixture}")
        configure_file("${CMAKE_BINARY_DIR}/runtime-fixes/native-camera-fixture.c.in"
            "${CMAKE_BINARY_DIR}/runtime-fixes/native-camera-fixture.c" COPYONLY)
        math(EXPR rotation_matches "${rotation_matches}+1")
    endif()
endforeach()
if(NOT camera_matches EQUAL 1 OR NOT rotation_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one audited camera update and rotation fixture.")
endif()
