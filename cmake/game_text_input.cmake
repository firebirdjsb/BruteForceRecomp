# Preserve the original generated bodies and wrap only the keyboard's draw and
# update entries. The source hash is for the exact private generated chunk;
# the host separately authenticates the retail XBE before executing any code.
set(input_matches 0)
foreach(file IN LISTS BF_GENERATED)
    file(READ "${file}" text)
    string(FIND "${text}" "void sub_0010D560(void)\n{" found)
    if(NOT found EQUAL -1)
        string(REPLACE "\r\n" "\n" text "${text}")
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "77a2c4f3b1ebddf4bfdd7278ba59e9778418aada8cc29a64a5bcff84d24f9fc1")
            message(FATAL_ERROR "Unaudited keyboard chunk; native text integration refused.")
        endif()
        math(EXPR input_matches "${input_matches} + 1")
        string(REPLACE "void sub_0010D560(void)\n{" "void bf_original_keyboard_draw(void)\n{" text "${text}")
        string(REPLACE "void sub_0010D5A0(void)\n{" "void bf_original_keyboard_update(void)\n{" text "${text}")
        string(PREPEND text "extern int bf_game_prompt(unsigned);\n")
        string(REPLACE "loc_0010CD90: ;\n    PUSH32(esp, esi);\n    esi = ecx;"
            "loc_0010CD90: ;\n    PUSH32(esp, esi);\n    esi = ecx;\n    if (bf_game_prompt(esi)) goto loc_0010CD9C;" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/game-keyboard.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
    endif()
endforeach()
if(NOT input_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original on-screen keyboard implementation.")
endif()
list(APPEND BF_GENERATED "${PROJECT_SOURCE_DIR}/src/game_text_guest.c" "${PROJECT_SOURCE_DIR}/src/game_text_input.cpp")
add_library(bf_text_events STATIC src/text_events.cpp)
target_include_directories(bf_text_events PRIVATE "${PROJECT_SOURCE_DIR}/src")
add_executable(bf_text_events_test tests/text_events_test.cpp)
target_link_libraries(bf_text_events_test PRIVATE bf_text_events)
target_include_directories(bf_text_events_test PRIVATE "${PROJECT_SOURCE_DIR}/src")
add_test(NAME native_text_events COMMAND bf_text_events_test)

# Keep keyboard-as-pad actions out of text entry; arrows still drive the
# original grid. The real gamepad path is not filtered.
set(original "${XBOXRECOMP_DIR}/src/input/keyboard.c")
file(READ "${original}" source)
string(REPLACE "\r\n" "\n" source "${source}")
string(SHA256 digest "${source}")
if(NOT digest STREQUAL "cf4cc96718246341823e40e2ae276e49f1ec2fc550f2a115cabec81c1a1d1424")
    message(FATAL_ERROR "Unaudited keyboard mapping source.")
endif()
string(PREPEND source "#include \"text_events.h\"\n")
string(REPLACE "uint8_t down[INPUT_KEY_COUNT];" "uint8_t down[INPUT_KEY_COUNT];\n    const int capture_text = bf_text_active();" source "${source}")
string(REPLACE "down[vk] = s_key_down[vk];"
    "down[vk] = (!capture_text || (vk >= 37 && vk <= 40)) ? s_key_down[vk] : 0;"
    source "${source}")
set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/game-key-mapping.c")
file(WRITE "${copy}.in" "${source}")
configure_file("${copy}.in" "${copy}" COPYONLY)
get_target_property(sources xbox_input SOURCES)
list(REMOVE_ITEM sources "${original}" "keyboard.c")
list(APPEND sources "${copy}")
set_property(TARGET xbox_input PROPERTY SOURCES "${sources}")
target_include_directories(xbox_input PRIVATE "${XBOXRECOMP_DIR}/src/input" "${PROJECT_SOURCE_DIR}/src")
target_link_libraries(xbox_input PUBLIC bf_text_events)

