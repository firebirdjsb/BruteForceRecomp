option(BF_MENU_DIAGNOSTICS "Trace original menu child iteration around the reproduced mode-start exit" OFF)
if(BF_MENU_DIAGNOSTICS)
    if(NOT WIN32)
        message(FATAL_ERROR "Menu diagnostics currently use the Windows own-process memory reader.")
    endif()
    set(matches 0)
    foreach(file IN LISTS BF_GENERATED)
        file(READ "${file}" text)
        string(FIND "${text}" "loc_00100716: ;\n    edi = MEM32(ebx);" found)
        if(NOT found EQUAL -1)
            math(EXPR matches "${matches} + 1")
            string(PREPEND text "extern void bf_trace_menu_child(unsigned, unsigned, unsigned, unsigned);\nextern void bf_trace_menu_insert(unsigned, unsigned, unsigned);\n")
            string(REPLACE "loc_000FF9E0: ;" "loc_000FF9E0: ;\n    bf_trace_menu_insert(0, edi, MEM32(esp + 4));" text "${text}")
            string(REPLACE "loc_000FFA2D: ;" "loc_000FFA2D: ;\n    bf_trace_menu_insert(1, edi, MEM32(esp + 8));" text "${text}")
            string(REPLACE "loc_00100716: ;\n    edi = MEM32(ebx);"
                "loc_00100716: ;\n    edi = MEM32(ebx);\n    bf_trace_menu_child(0, ebp, ebx, edi);" text "${text}")
            string(REPLACE "loc_00100727: ;" "loc_00100727: ;\n    if (!edi) bf_trace_menu_child(1, ebp, ebx, edi);" text "${text}")
            string(REPLACE "loc_00100733: ;" "loc_00100733: ;\n    if (!edi) bf_trace_menu_child(2, ebp, ebx, edi);" text "${text}")
            set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/menu-child-trace.c")
            file(WRITE "${copy}.in" "${text}")
            configure_file("${copy}.in" "${copy}" COPYONLY)
            list(REMOVE_ITEM BF_GENERATED "${file}")
            list(APPEND BF_GENERATED "${copy}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected exactly one original menu update body.")
    endif()
endif()
