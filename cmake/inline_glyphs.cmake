# Draw-only adapter, authenticated against the complete original text chunk.
set(glyph_matches 0)
set(gameplay_glyph_matches 0)
set(ui_quad_matches 0)
set(hud_quad_matches 0)
set(hud_owner_matches 0)
foreach(file IN LISTS BF_GENERATED)
    file(READ "${file}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(FIND "${text}" "loc_000B2720: ;" owner_found)
    if(NOT owner_found EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "8280425f30b5b5af65938be81b22362d43f3a9c0c472286046a4dd3ff2eb93df")
            message(FATAL_ERROR "Unaudited native HUD child dispatcher.")
        endif()
        set(owner_call "{ uint32_t _icall_target = MEM32(eax + 0x18); PUSH32(esp, 0x000B2761u); RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x000B275Eu); } /* indirect call */")
        string(FIND "${text}" "${owner_call}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Expected complete native component draw call.")
        endif()
        string(PREPEND text "extern unsigned bf_guest_hud_trace_begin(unsigned,unsigned);\nextern void bf_guest_hud_trace_end(unsigned);\nextern unsigned bf_guest_hud_owner_begin(unsigned);\nextern void bf_guest_hud_owner_end(unsigned);\n")
        string(REPLACE "${owner_call}" "{ uint32_t _bf_hud_owner = bf_guest_hud_owner_begin(esi);\n    uint32_t _bf_hud_trace = bf_guest_hud_trace_begin(4,esi);\n    ${owner_call}\n    bf_guest_hud_trace_end(_bf_hud_trace);\n    bf_guest_hud_owner_end(_bf_hud_owner); }" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/hud-owner-trace.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR hud_owner_matches "${hud_owner_matches}+1")
    endif()
    string(FIND "${text}" "loc_000BA950: ;" hud_found)
    if(NOT hud_found EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "d51c8e0605f62e43f2b4179d860ddfa0206fdbc0d01e4970fc113f6ddf0c4035")
            message(FATAL_ERROR "Unaudited native HUD image renderer.")
        endif()
        # Original native-component image/rectangle primitive. It emits HUD
        # artwork before CCD20 is reached, so a font-only boundary is too late.
        string(PREPEND text "extern void bf_guest_ui_boundary(void);\nextern int bf_guest_hud_trace_active(void);\nextern void bf_guest_hud_trace_rect(float,float);\n")
        string(REPLACE "void sub_000BA950(void)\n{" "void bf_original_hud_image(void)\n{" text "${text}")
        string(REPLACE "loc_000BA950: ;" "loc_000BA950: ;\n    bf_guest_ui_boundary();" text "${text}")
        # BAF03 precedes Begin(QUADS). Parent scale/clipping are complete;
        # x=[esp+1C]+[esp+78], signed width=[esp+40] are used by all 4 corners.
        string(REPLACE "loc_000BAF03: ;" "loc_000BAF03: ;\n    if(bf_guest_hud_trace_active())bf_guest_hud_trace_rect(MEMF(esp+0x1C)+MEMF(esp+0x78),MEMF(esp+0x40));" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/hud-image-boundary.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR hud_quad_matches "${hud_quad_matches}+1")
    endif()
    string(FIND "${text}" "loc_000CCD20: ;" gameplay_found)
    if(NOT gameplay_found EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "b1f1ddf5941485a1de4ebf1839b10321630c622d1cecbef14e6fdaa8c6b90275")
            message(FATAL_ERROR "Unaudited gameplay font draw; glyph replacement refused.")
        endif()
        string(PREPEND text "extern int bf_gameplay_glyph(unsigned);\nextern void bf_guest_ui_boundary(void);\n")
        string(REPLACE "void sub_000CCD20(void)\n{" "void bf_original_font_draw(void)\n{" text "${text}")
        string(REPLACE "loc_000CCD20: ;" "loc_000CCD20: ;\n    bf_guest_ui_boundary();" text "${text}")
        string(REPLACE "loc_000CD219: ;" "loc_000CD219: ;\n    if (bf_gameplay_glyph(esp)) goto loc_000CD2B9;" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/gameplay-inline-glyphs.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR gameplay_glyph_matches "${gameplay_glyph_matches}+1")
    endif()
    string(FIND "${text}" "loc_000EE6E0: ;" quad_found)
    if(NOT quad_found EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "d5c86d02b5bbadccbbe827b136baaf74257ded1b9de0d0f9f6695d04600dfe58")
            message(FATAL_ERROR "Unaudited original UI quad renderer.")
        endif()
        string(PREPEND text "extern void bf_guest_ui_boundary(void);\nextern int bf_guest_hud_trace_active(void);\nextern void bf_guest_hud_trace_rect(float,float);\n")
        string(REPLACE "void sub_000EE6E0(void)\n{" "void bf_original_ui_quad(void)\n{" text "${text}")
        string(REPLACE "loc_000EE6E0: ;" "loc_000EE6E0: ;\n    bf_guest_ui_boundary();" text "${text}")
        # EE8F5 precedes Begin(QUADS), after original parent-origin resolution.
        # The emitted corners use x=[esp+10], width=[esp+48].
        string(REPLACE "loc_000EE8F5: ;" "loc_000EE8F5: ;\n    if(bf_guest_hud_trace_active())bf_guest_hud_trace_rect(MEMF(esp+0x10),MEMF(esp+0x48));" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/ui-quad-boundary.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR ui_quad_matches "${ui_quad_matches}+1")
    endif()
    string(FIND "${text}" "void sub_0010A600(void)" found)
    if(NOT found EQUAL -1)
        string(REPLACE "\r\n" "\n" text "${text}")
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "2afc0caf14d58ca437b40575990d03ce8968d69951fb20d5d0cbbc158c9126f7")
            message(FATAL_ERROR "Unaudited original text draw; inline glyph replacement refused.")
        endif()
        set(anchor "loc_0010A600: ;\n    PUSH32(esp, esi);\n    esi = ecx;")
        string(FIND "${text}" "${anchor}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Expected original text-draw prologue.")
        endif()
        string(PREPEND text "extern int bf_game_text_prompt(unsigned);\n")
        string(REPLACE "${anchor}" "${anchor}\n    if (bf_game_text_prompt(esi)) goto loc_0010A622;" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/game-inline-glyphs.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR glyph_matches "${glyph_matches}+1")
    endif()
endforeach()
if(NOT glyph_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original text draw.")
endif()
if(NOT gameplay_glyph_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one gameplay font draw.")
endif()
if(NOT ui_quad_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original UI quad renderer.")
endif()
if(NOT hud_quad_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one native HUD image renderer.")
endif()
if(NOT hud_owner_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one native HUD child dispatcher.")
endif()
list(APPEND BF_GENERATED "${PROJECT_SOURCE_DIR}/src/ui/gameplay_glyphs.cpp" "${PROJECT_SOURCE_DIR}/src/ui/prompt_text.cpp" "${PROJECT_SOURCE_DIR}/src/ui/hud_anchor.cpp")
add_executable(bf_hud_anchor_test tests/hud_anchor_test.cpp src/ui/hud_anchor.cpp)
target_include_directories(bf_hud_anchor_test PRIVATE src "${XBOXRECOMP_DIR}/src" "${XBOXRECOMP_DIR}/src/kernel")
target_link_libraries(bf_hud_anchor_test PRIVATE bf_host_ui)
add_test(NAME hud_widget_anchors COMMAND bf_hud_anchor_test)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
add_test(NAME hud_owner_trace COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/check_hud_owner_trace.py" "$<TARGET_FILE:bf_hud_anchor_test>")
