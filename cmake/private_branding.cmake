include_guard(GLOBAL)
set(BF_PRIVATE_BRANDING_DIR "" CACHE PATH "Locally extracted title branding, outside source control")
if(WIN32 AND EXISTS "${BF_PRIVATE_BRANDING_DIR}/bruteforce.ico")
    enable_language(RC)
endif()
function(bf_attach_private_icon target)
    if(WIN32 AND EXISTS "${BF_PRIVATE_BRANDING_DIR}/bruteforce.ico")
        file(TO_CMAKE_PATH "${BF_PRIVATE_BRANDING_DIR}/bruteforce.ico" icon)
        set(resource "${CMAKE_CURRENT_BINARY_DIR}/${target}-icon.rc")
        file(WRITE "${resource}" "101 ICON \"${icon}\"\n")
        target_sources(${target} PRIVATE "${resource}")
    endif()
endfunction()
