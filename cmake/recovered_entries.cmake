# Keep canonical discovery/audit output intact. Only the original CRT branch
# now recovered from authenticated bytes replaces its previous hard stop.
set(unresolved_source "${BF_GENERATED_DIR}/recomp_stubs_unresolved.c")
file(READ "${unresolved_source}" unresolved)
string(REPLACE "\r\n" "\n" unresolved "${unresolved}")
string(SHA256 digest "${unresolved}")
if(NOT digest STREQUAL "4aa06b730fe8c00599ff122b250e2694b769b3d115c51d8db93f220294e23ade")
    message(FATAL_ERROR "Unaudited unresolved-target inventory; CRT recovery refused.")
endif()
set(original [=[void sub_002F04E3(void) { recomp_unimpl("Unresolved direct-call target", 0x002F04E3u); g_esp += 4; /* 0x002F04E3: not detected */ }]=])
string(FIND "${unresolved}" "${original}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Expected original CRT unresolved target.")
endif()
string(REPLACE "${original}" "/* 0x002F04E3 is defined by the authenticated private CRT recovery. */" unresolved "${unresolved}")
set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/recovered-unresolved.c")
file(WRITE "${copy}.in" "${unresolved}")
configure_file("${copy}.in" "${copy}" COPYONLY)
list(REMOVE_ITEM BF_GENERATED "${unresolved_source}")
list(APPEND BF_GENERATED "${copy}")
