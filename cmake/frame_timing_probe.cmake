option(BF_FRAME_TIMING_DIAGNOSTICS "Build read-only retail frame timing probes" OFF)
if(NOT BF_FRAME_TIMING_DIAGNOSTICS)
    return()
endif()
if(NOT BF_EXPERIMENTAL_NV2A_D3D11)
    message(FATAL_ERROR "The frame timing probes require the audited GPU executor.")
endif()
set(matches 0)
foreach(file IN LISTS BF_GENERATED)
    file(READ "${file}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(FIND "${text}" "void sub_002C6A00(void)\n{" found)
    if(NOT found EQUAL -1)
        string(SHA256 digest "${text}")
        if(NOT digest STREQUAL "577617b76bd750014c0038287c6fc7c3ce5ff5e143d3cb51f89b71945e5ee4ef")
            message(FATAL_ERROR "Unaudited physics timing chunk; diagnostic refused.")
        endif()
        string(PREPEND text "extern void bf_frame_probe_body(unsigned,unsigned,unsigned);\n")
        string(REPLACE "loc_002C6A7B: ;\n" "loc_002C6A7B: ;\n    bf_frame_probe_body(ebp,esi,esp);\n" text "${text}")
        set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/frame-timing-probe.c")
        file(WRITE "${copy}.in" "${text}")
        configure_file("${copy}.in" "${copy}" COPYONLY)
        list(REMOVE_ITEM BF_GENERATED "${file}")
        list(APPEND BF_GENERATED "${copy}")
        math(EXPR matches "${matches}+1")
    else()
        string(FIND "${text}" "void sub_002C7D00(void)\n{" found)
        if(NOT found EQUAL -1)
            string(SHA256 digest "${text}")
            if(NOT digest STREQUAL "d1a1dc4aae673d1bf23e83475d76e53812326c2610da120e078f6b4d592e9efd")
                message(FATAL_ERROR "Unaudited physics clock chunk; diagnostic refused.")
            endif()
            string(PREPEND text "extern void bf_frame_probe_clock(unsigned,unsigned);\n")
            string(REPLACE "loc_002C7D00: ;\n" "loc_002C7D00: ;\n    bf_frame_probe_clock(MEM32(esp+8),esp);\n" text "${text}")
            set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/frame-clock-probe.c")
            file(WRITE "${copy}.in" "${text}")
            configure_file("${copy}.in" "${copy}" COPYONLY)
            list(REMOVE_ITEM BF_GENERATED "${file}")
            list(APPEND BF_GENERATED "${copy}")
            math(EXPR matches "${matches}+1")
        endif()
    endif()
endforeach()
if(NOT matches EQUAL 2)
    message(FATAL_ERROR "Expected both authenticated physics timing entries.")
endif()
list(APPEND BF_GENERATED "${PROJECT_SOURCE_DIR}/src/frame_timing_probe.cpp")
