if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR ANDROID)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/scripts/prepare_posix_runtime.py")
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(posix_sources "${CMAKE_BINARY_DIR}/runtime-fixes/posix")
    execute_process(COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/scripts/prepare_posix_runtime.py"
        --toolkit "${XBOXRECOMP_DIR}" --output "${posix_sources}"
        COMMAND_ERROR_IS_FATAL ANY)
    foreach(pair "xbox_kernel|kernel/xbox_memory_layout.c" "xbox_apu|apu/apu_mmio_hook.c" "xbox_usb|usb/ohci.c")
        string(REPLACE "|" ";" fields "${pair}")
        list(GET fields 0 target)
        list(GET fields 1 relative)
        get_filename_component(filename "${relative}" NAME)
        get_target_property(sources "${target}" SOURCES)
        get_target_property(directory "${target}" SOURCE_DIR)
        set(replaced)
        foreach(source IN LISTS sources)
            get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${directory}")
            if(absolute STREQUAL "${XBOXRECOMP_DIR}/src/${relative}")
                list(APPEND replaced "${posix_sources}/${filename}")
            else()
                list(APPEND replaced "${absolute}")
            endif()
        endforeach()
        set_property(TARGET "${target}" PROPERTY SOURCES "${replaced}")
        target_include_directories("${target}" PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src" "${directory}")
    endforeach()
endif()
