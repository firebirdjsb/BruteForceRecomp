function(bf_add_motion_renderer)
    if(TARGET bf_motion_renderer)
        return()
    endif()
    add_library(bf_motion_history STATIC "${PROJECT_SOURCE_DIR}/src/gpu/motion_history.cpp")
    target_include_directories(bf_motion_history PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_compile_definitions(bf_motion_history PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(bf_motion_history PUBLIC d3d11 d3dcompiler)
    add_library(bf_motion_renderer STATIC "${PROJECT_SOURCE_DIR}/src/gpu/motion_renderer.cpp")
    target_include_directories(bf_motion_renderer PUBLIC "${PROJECT_SOURCE_DIR}/src"
        "${PROJECT_SOURCE_DIR}/src/gpu/runtime" "${XBOXRECOMP_DIR}/src/kernel" PRIVATE "${PROJECT_SOURCE_DIR}/src/gpu")
    target_link_libraries(bf_motion_renderer PUBLIC bf_motion_history)
    if(BF_RUNTIME_CHECKS_ONLY)
        add_executable(bf_motion_history_test "${PROJECT_SOURCE_DIR}/tests/motion_history_test.cpp")
        target_link_libraries(bf_motion_history_test PRIVATE bf_motion_history)
        add_test(NAME motion_history_gpu COMMAND bf_motion_history_test)
        add_executable(bf_motion_renderer_test "${PROJECT_SOURCE_DIR}/tests/motion_renderer_test.cpp")
        target_link_libraries(bf_motion_renderer_test PRIVATE bf_motion_renderer bf_scene_device)
        add_test(NAME motion_renderer_gpu11 COMMAND bf_motion_renderer_test)
        add_test(NAME motion_renderer_gpu12 COMMAND bf_motion_renderer_test --d3d12)
        set_tests_properties(motion_history_gpu motion_renderer_gpu11 motion_renderer_gpu12 PROPERTIES TIMEOUT 90)
    endif()
endfunction()
