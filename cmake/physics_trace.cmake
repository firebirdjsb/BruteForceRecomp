option(BF_PHYSICS_DIAGNOSTICS "Trace the original center-of-mass transform without altering its behavior" OFF)
if(BF_PHYSICS_DIAGNOSTICS)
    set(matches 0)
    foreach(file IN LISTS BF_GENERATED)
        file(READ "${file}" text)
        string(FIND "${text}" "void sub_002B2BC0(void)\n{" found)
        if(NOT found EQUAL -1)
            string(REPLACE "\r\n" "\n" text "${text}")
            string(SHA256 digest "${text}")
            if(NOT digest STREQUAL "ab84bd9ba2db988ac3f891ce9061bde259da0427591947685ff1c86bb82bfef6")
                message(FATAL_ERROR "Unaudited physics chunk; diagnostic refused.")
            endif()
            string(PREPEND text "extern void bf_trace_center(unsigned,unsigned,unsigned);\n")
            string(REPLACE "loc_002B2BC0: ;" "loc_002B2BC0: ;\n    bf_trace_center(0,ecx,MEM32(esp+4));" text "${text}")
            string(REPLACE "loc_002B2D32: ;" "loc_002B2D32: ;\n    bf_trace_center(1,MEM32(esp+4),MEM32(esp+0x54));" text "${text}")
            set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/physics-center.c")
            file(WRITE "${copy}.in" "${text}")
            configure_file("${copy}.in" "${copy}" COPYONLY)
            list(REMOVE_ITEM BF_GENERATED "${file}")
            list(APPEND BF_GENERATED "${copy}")
            math(EXPR matches "${matches}+1")
        else()
            string(FIND "${text}" "void sub_00158CD0(void)\n{" constructor)
            string(FIND "${text}" "void sub_002B97D0(void)\n{" getter)
            string(FIND "${text}" "void sub_001590A0(void)\n{" model)
            string(FIND "${text}" "void sub_0025E610(void)\n{" relocation)
            if(NOT constructor EQUAL -1 OR NOT getter EQUAL -1 OR NOT model EQUAL -1 OR NOT relocation EQUAL -1)
                string(REPLACE "\r\n" "\n" text "${text}")
                string(SHA256 digest "${text}")
                if(NOT constructor EQUAL -1)
                    if(NOT digest STREQUAL "4dda53ffa232c6564dcb2c57dfc6933fd60777c054575f8967e5f3b41de5ed10")
                        message(FATAL_ERROR "Unaudited geometry constructor chunk.")
                    endif()
                    string(REPLACE "loc_00158D07: ;" "loc_00158D07: ;\n    bf_trace_proxy(0,MEM32(esp+0xC),MEM32(ebp+8),MEM32(ebp+4));" text "${text}")
                    set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/physics-proxy-create.c")
                elseif(NOT getter EQUAL -1)
                    if(NOT digest STREQUAL "7873f69f5177587ffab13d8c9a78fa346b05f21b37eff2c20d5297bf29ea1465")
                        message(FATAL_ERROR "Unaudited geometry getter chunk.")
                    endif()
                    string(REPLACE "loc_002B97D0: ;" "loc_002B97D0: ;\n    bf_trace_proxy(1,ecx,MEM32(ecx+4),MEM32(esp));" text "${text}")
                    set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/physics-proxy-read.c")
                elseif(NOT model EQUAL -1)
                    if(NOT digest STREQUAL "b6d590d8202632a997b96d06b13658eaaad8ec8357ab4f3e8fa50e2abcbb216f")
                        message(FATAL_ERROR "Unaudited model setup chunk.")
                    endif()
                    string(PREPEND text "extern void bf_trace_model(unsigned);\n")
                    string(REPLACE "loc_001590E7: ;" "loc_001590E7: ;\n    bf_trace_model(ebp);" text "${text}")
                    set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/physics-model.c")
                else()
                    if(NOT digest STREQUAL "8d4edc0a7f6c51a12301f25e0d8d2f112a16ad5f72adefa9e73ac628f66cdc04")
                        message(FATAL_ERROR "Unaudited geometry relocation chunk.")
                    endif()
                    string(PREPEND text "extern void bf_trace_ipn(unsigned,unsigned,unsigned,unsigned);\n")
                    string(REPLACE "loc_0025E5D0: ;" "loc_0025E5D0: ;\n    bf_trace_ipn(0,esi,edi,0);" text "${text}")
                    string(REPLACE "loc_0025E5F6: ;" "loc_0025E5F6: ;\n    bf_trace_ipn(1,esi,edi,eax);" text "${text}")
                    string(REPLACE "loc_0025E610: ;" "loc_0025E610: ;\n    bf_trace_ipn(2,edx,0,0);" text "${text}")
                    string(REPLACE "loc_0025E62F: ;" "loc_0025E62F: ;\n    bf_trace_ipn(3,0,0,0);" text "${text}")
                    set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/physics-relocation.c")
                endif()
                string(PREPEND text "extern void bf_trace_proxy(unsigned,unsigned,unsigned,unsigned);\n")
                file(WRITE "${copy}.in" "${text}")
                configure_file("${copy}.in" "${copy}" COPYONLY)
                list(REMOVE_ITEM BF_GENERATED "${file}")
                list(APPEND BF_GENERATED "${copy}")
                math(EXPR matches "${matches}+1")
            endif()
        endif()
    endforeach()
    if(NOT matches EQUAL 5)
        message(FATAL_ERROR "Expected original physics center, proxy constructor, getter, model setup and relocation.")
    endif()
    list(APPEND BF_GENERATED "${PROJECT_SOURCE_DIR}/src/physics_trace.cpp")
    get_target_property(kernel_sources xbox_kernel SOURCES)
    get_target_property(kernel_directory xbox_kernel SOURCE_DIR)
    set(traced_kernel_sources)
    foreach(item IN LISTS kernel_sources)
        get_filename_component(absolute "${item}" ABSOLUTE BASE_DIR "${kernel_directory}")
        get_filename_component(name "${absolute}" NAME)
        if(name STREQUAL "kernel_bridge.c")
            # This private copy has already passed the pinned bridge hash gate.
            file(READ "${absolute}" text)
            set(marker "        if (status) {\n            /* Once a path")
            string(FIND "${text}" "${marker}" found)
            if(found EQUAL -1)
                message(FATAL_ERROR "Expected resource-open trace anchor.")
            endif()
            string(REPLACE "${marker}" "        if(disposition==1 && (strstr(gpath,\".ipn\") || strstr(gpath,\".ivd\"))) {\n            extern void bf_trace_resource(unsigned);bf_trace_resource(g_esp);\n        }\n${marker}" text "${text}")
            set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/physics-resource-bridge.c")
            file(WRITE "${copy}.in" "${text}")
            configure_file("${copy}.in" "${copy}" COPYONLY)
            list(APPEND traced_kernel_sources "${copy}")
        else()
            list(APPEND traced_kernel_sources "${absolute}")
        endif()
    endforeach()
    set_property(TARGET xbox_kernel PROPERTY SOURCES "${traced_kernel_sources}")
endif()
