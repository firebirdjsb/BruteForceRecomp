function(bf_add_scene_snapshot)
    if(TARGET bf_scene_snapshot)
        return()
    endif()
    add_library(bf_scene_snapshot STATIC "${PROJECT_SOURCE_DIR}/src/gpu/scene_snapshot.cpp")
    target_include_directories(bf_scene_snapshot PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(bf_scene_snapshot PUBLIC d3d11 d3dcompiler)
    add_executable(bf_scene_snapshot_test "${PROJECT_SOURCE_DIR}/tests/scene_snapshot_test.cpp"
        "${PROJECT_SOURCE_DIR}/src/gpu/scene_device.cpp")
    target_link_libraries(bf_scene_snapshot_test PRIVATE bf_scene_snapshot d3d12 dxgi)
    add_test(NAME scene_snapshot_d3d11 COMMAND bf_scene_snapshot_test)
    add_test(NAME scene_snapshot_d3d12 COMMAND bf_scene_snapshot_test --d3d12)
    set_tests_properties(scene_snapshot_d3d11 scene_snapshot_d3d12 PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 30)
endfunction()
