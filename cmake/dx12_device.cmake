function(bf_add_dx12_device)
    if(TARGET bf_dx12_device)
        return()
    endif()
    add_library(bf_dx12_device STATIC "${PROJECT_SOURCE_DIR}/src/graphics/dx12_device.cpp")
    target_include_directories(bf_dx12_device PUBLIC "${PROJECT_SOURCE_DIR}/src/graphics")
    target_link_libraries(bf_dx12_device PUBLIC d3d12 dxgi dxguid)
    if(MSVC)
        target_compile_options(bf_dx12_device PRIVATE /W4)
    endif()
endfunction()
