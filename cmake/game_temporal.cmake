include("${CMAKE_CURRENT_LIST_DIR}/dx12_device.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/scene_device.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/fsr_temporal.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/upscaler_state.cmake")
function(bf_add_game_temporal)
    if(TARGET bf_game_temporal)
        return()
    endif()
    bf_add_scene_device()
    bf_add_fsr_temporal()
    bf_add_upscaler_state()
    add_library(bf_game_temporal STATIC "${PROJECT_SOURCE_DIR}/src/graphics/game_temporal.cpp"
        "${PROJECT_SOURCE_DIR}/src/graphics/temporal_control.cpp"
        "${PROJECT_SOURCE_DIR}/src/graphics/temporal_handoff.cpp")
    target_include_directories(bf_game_temporal PUBLIC "${PROJECT_SOURCE_DIR}/src")
    target_compile_definitions(bf_game_temporal PRIVATE NOMINMAX)
    target_link_libraries(bf_game_temporal PUBLIC bf_scene_device bf_upscaler_state)
    if(TARGET bf_fsr_temporal)
        target_link_libraries(bf_game_temporal PRIVATE bf_fsr_temporal)
        target_compile_definitions(bf_game_temporal PRIVATE BF_HAS_FSR_TEMPORAL=1)
    endif()
    if(MSVC)
        target_compile_options(bf_game_temporal PRIVATE /W4)
    endif()
endfunction()
function(bf_add_game_temporal_tests)
    bf_add_game_temporal()
    add_executable(bf_game_temporal_test "${PROJECT_SOURCE_DIR}/tests/game_temporal_test.cpp")
    target_link_libraries(bf_game_temporal_test PRIVATE bf_game_temporal bf_dx12)
    add_executable(bf_temporal_control_test "${PROJECT_SOURCE_DIR}/tests/temporal_control_test.cpp")
    target_link_libraries(bf_temporal_control_test PRIVATE bf_game_temporal bf_scene_device)
    if(TARGET bf_fsr_temporal)
        target_compile_definitions(bf_game_temporal_test PRIVATE BF_HAS_FSR_TEMPORAL=1)
        bf_attach_fsr_runtime(bf_game_temporal_test)
        bf_attach_fsr_runtime(bf_temporal_control_test)
        add_test(NAME game_temporal_sdk_hardware COMMAND bf_game_temporal_test)
        add_test(NAME game_temporal_fsr3_hardware COMMAND bf_game_temporal_test --fsr3)
        set_tests_properties(game_temporal_sdk_hardware game_temporal_fsr3_hardware PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 120)
        add_test(NAME game_temporal_control_fsr3_hardware COMMAND bf_temporal_control_test --fsr3)
        add_test(NAME game_temporal_control_fsr4_hardware COMMAND bf_temporal_control_test --fsr4)
        set_tests_properties(game_temporal_control_fsr3_hardware game_temporal_control_fsr4_hardware PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 90)
    else()
        add_test(NAME game_temporal_unavailable COMMAND bf_game_temporal_test)
        add_test(NAME game_temporal_control_unavailable COMMAND bf_temporal_control_test)
    endif()
endfunction()
