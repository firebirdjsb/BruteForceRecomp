# The GPU presenter is independent of generated/private game code.
function(bf_shader_chunks input output)
    # VS 2022 limits individual raw string tokens. Keep each token below
    # 8 KB and assemble separate appends, preserving the source bytes.
    set(code)
    string(LENGTH "${${input}}" length)
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${${input}}" ${offset} 8192 chunk)
        string(FIND "${chunk}" ")BF_SHADER\"" delimiter)
        if(NOT delimiter EQUAL -1)
            message(FATAL_ERROR "Shader source contains the reserved raw-string delimiter.")
        endif()
        string(APPEND code "    result.append(R\"BF_SHADER(${chunk})BF_SHADER\");\n")
        math(EXPR offset "${offset} + 8192")
    endwhile()
    set(${output} "${code}" PARENT_SCOPE)
endfunction()

include("${CMAKE_CURRENT_LIST_DIR}/fsr_temporal.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/scene_snapshot.cmake")

function(bf_add_dx12_library)
    if(NOT WIN32)
        message(FATAL_ERROR "DX12 is a Windows backend. Linux and Android retain their own native graphics paths.")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/src/graphics/present.hlsl"
        "${PROJECT_SOURCE_DIR}/src/graphics/interpolation.hlsl"
        "${PROJECT_SOURCE_DIR}/third_party/fsr1/ffx_a.h"
        "${PROJECT_SOURCE_DIR}/third_party/fsr1/ffx_fsr1.h")
    file(READ "${PROJECT_SOURCE_DIR}/src/graphics/present.hlsl" BF_PRESENT_HLSL)
    file(READ "${PROJECT_SOURCE_DIR}/src/graphics/interpolation.hlsl" BF_INTERPOLATION_HLSL)
    file(READ "${PROJECT_SOURCE_DIR}/third_party/fsr1/ffx_a.h" BF_FFX_A)
    file(READ "${PROJECT_SOURCE_DIR}/third_party/fsr1/ffx_fsr1.h" BF_FFX_FSR1)
    bf_shader_chunks(BF_FFX_A BF_FFX_A_CHUNKS)
    bf_shader_chunks(BF_FFX_FSR1 BF_FFX_FSR1_CHUNKS)
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/graphics")
    configure_file("${PROJECT_SOURCE_DIR}/src/graphics/shaders.h.in" "${CMAKE_BINARY_DIR}/graphics/shaders.h" @ONLY)
    bf_add_fsr_temporal()
    bf_add_scene_snapshot()
    add_library(bf_dx12 STATIC "${PROJECT_SOURCE_DIR}/src/graphics/dx12_presenter.cpp"
        "${PROJECT_SOURCE_DIR}/src/graphics/frame_interpolation.cpp")
    target_include_directories(bf_dx12 PRIVATE "${CMAKE_BINARY_DIR}/graphics" "${PROJECT_SOURCE_DIR}/third_party/fsr1")
    target_include_directories(bf_dx12 PUBLIC "${PROJECT_SOURCE_DIR}/src/graphics")
    target_link_libraries(bf_dx12 PUBLIC d3d12 dxgi dxguid d3dcompiler)
    if(MSVC)
        target_compile_options(bf_dx12 PRIVATE /W4)
    endif()
endfunction()

if(WIN32 AND TARGET xbox_video)
    bf_add_dx12_library()
    set(original "${XBOXRECOMP_DIR}/src/video/gpu_present.c")
    file(READ "${original}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    string(SHA256 hash "${source}")
    if(NOT hash STREQUAL "36f55e5a985cb9db495128bed4bfb99a5b5d5f78a0729e32cd14dcafa5efb37f")
        message(FATAL_ERROR "D3D11 fallback source differs from the audited pinned revision.")
    endif()
    foreach(name enabled init frame active shutdown)
        string(REPLACE "gpu_present_${name}(" "bf_d3d11_${name}(" source "${source}")
    endforeach()
    string(PREPEND source "void bf_d3d11_shutdown(void);\n")
    set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/gpu_present_d3d11.c")
    file(WRITE "${copy}.in" "${source}")
    configure_file("${copy}.in" "${copy}" COPYONLY)
    get_target_property(sources xbox_video SOURCES)
    get_target_property(directory xbox_video SOURCE_DIR)
    set(replaced)
    foreach(item IN LISTS sources)
        get_filename_component(absolute "${item}" ABSOLUTE BASE_DIR "${directory}")
        if(absolute STREQUAL original)
            list(APPEND replaced "${copy}")
        else()
            list(APPEND replaced "${absolute}")
        endif()
    endforeach()
    set_property(TARGET xbox_video PROPERTY SOURCES "${replaced}")
    target_sources(xbox_video PRIVATE "${PROJECT_SOURCE_DIR}/src/graphics/present_dispatch.cpp")
    target_link_libraries(xbox_video PUBLIC bf_dx12)
endif()
