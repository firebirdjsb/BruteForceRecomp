function(bf_add_upscaler_state)
    if(TARGET bf_upscaler_state)
        return()
    endif()
    add_library(bf_upscaler_state STATIC "${PROJECT_SOURCE_DIR}/src/ui/upscaler_state.cpp")
    target_include_directories(bf_upscaler_state PUBLIC "${PROJECT_SOURCE_DIR}/src/ui")
    if(MSVC)
        target_compile_options(bf_upscaler_state PRIVATE /W4)
    endif()
    add_executable(bf_upscaler_state_test "${PROJECT_SOURCE_DIR}/tests/upscaler_state_test.cpp")
    target_include_directories(bf_upscaler_state_test PRIVATE "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(bf_upscaler_state_test PRIVATE bf_upscaler_state)
    add_test(NAME upscaler_state_and_settings COMMAND bf_upscaler_state_test)
endfunction()
