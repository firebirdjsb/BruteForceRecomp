option(BF_BINK_DIAGNOSTICS "Trace the original Bink copy inputs/output without changing its behavior (Windows)" OFF)
if(BF_BINK_DIAGNOSTICS)
    if(NOT WIN32)
        message(FATAL_ERROR "Bink memory diagnostics currently use the Windows own-process read API.")
    endif()
    set(matches 0)
    foreach(file IN LISTS BF_GENERATED)
        file(READ "${file}" text)
        set(layout_found FALSE)
        foreach(va 002F8CB0 002F8DA0)
            string(FIND "${text}" "void sub_${va}(void)\n{" layout_at)
            if(NOT layout_at EQUAL -1)
                string(REPLACE "void sub_${va}(void)\n{" "void bf_original_${va}(void)\n{" text "${text}")
                set(layout_found TRUE)
            endif()
        endforeach()
        string(FIND "${text}" "void sub_003574B0(void)\n{" open_found)
        if(NOT open_found EQUAL -1)
            string(REPLACE "void sub_003574B0(void)\n{" "void bf_original_bink_open(void)\n{" text "${text}")
        endif()
        string(FIND "${text}" "void sub_00359280(void)\n{" found)
        if(NOT found EQUAL -1)
            math(EXPR matches "${matches} + 1")
            string(REPLACE "void sub_00359280(void)\n{" "void bf_original_bink_copy(void)\n{" text "${text}")
        endif()
        if(NOT found EQUAL -1 OR NOT open_found EQUAL -1 OR layout_found)
            get_filename_component(chunk "${file}" NAME)
            set(copy "${CMAKE_BINARY_DIR}/runtime-fixes/bink-trace-${chunk}")
            file(WRITE "${copy}.in" "${text}")
            configure_file("${copy}.in" "${copy}" COPYONLY)
            list(REMOVE_ITEM BF_GENERATED "${file}")
            list(APPEND BF_GENERATED "${copy}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected exactly one original BinkCopyToBuffer definition.")
    endif()
    list(APPEND BF_GENERATED "${PROJECT_SOURCE_DIR}/src/bink_trace.cpp")
endif()
